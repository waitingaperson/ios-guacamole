 IOReturn
 SweetAcceleratorClient::clientMemoryForType(UInt32 type, IOOptionBits *options,
     IOMemoryDescriptor **memory)
@@ -246,7 +586,10 @@ SweetAcceleratorClient::clientMemoryForType(UInt32 type, IOOptionBits *options,
 	if (memory == NULL) {
 		return kIOReturnBadArgument;
 	}
-	if (sweet_a6xx_bo_info((uint64_t)type, &kva, &size) || kva == 0 || size == 0) {
+	int rc = fAbiOwner ?
+	    sweet_a6xx_native_bo_info(fAbiOwner, type, &kva, &size) :
+	    sweet_a6xx_bo_info((uint64_t)type, &kva, &size);
+	if (rc || kva == 0 || size == 0) {
 		return kIOReturnNotFound;
 	}
 	IOMemoryDescriptor *md = IOMemoryDescriptor::withAddress((void *)kva, (IOByteCount)size,

