+/* ======================================================================
+ * NativeAdreno ABI v2 BO and submission bridge.
+ *
+ * Turnip allocates and maps many short-lived buffers.  Keep this state
+ * separate from the four display slots and the small SweetMetal BO table so
+ * either userland path can run without changing the other's contract.
+ * ====================================================================== */
+
+#define NATIVE_MAX_BO		4096
+#define NATIVE_VA_BASE		0x2000000000ULL	/* 128 GB */
+#define NATIVE_VA_SIZE		0x1000000000ULL	/* 64 GB, below the 39-bit limit */
+#define NATIVE_MAX_BO_BYTES	0x20000000ULL	/* 512 MiB per allocation */
+
+struct sweet_native_bo {
+	uint64_t owner;
+	uint64_t size;
+	uint64_t pa;
+	uint64_t iova;
+	vm_offset_t kva;
+	uint32_t leases;
+	uint8_t metadata[64];
+	bool used;
+	bool mapped;
+	bool metadata_set;
+};
+
+static struct sweet_native_bo native_bos[NATIVE_MAX_BO];
+static uint64_t native_next_owner;
+int a6_unmap_pages(struct a6_gpu *g, uint64_t iova, uint32_t npages, uint32_t page_size);
+
+static struct sweet_native_bo *
+native_bo(uint64_t owner, uint64_t handle)
+{
+	if (owner == 0 || handle == 0 || handle > NATIVE_MAX_BO) {
+		return NULL;
+	}
+	struct sweet_native_bo *b = &native_bos[handle - 1];
+	return b->used && b->owner == owner ? b : NULL;
+}
+
+static void
+native_bo_destroy(struct sweet_native_bo *b)
+{
+	if (b->mapped) {
+		(void)a6_unmap_pages(&gpu, b->iova, (uint32_t)(b->size >> PAGE_SHIFT),
+		    PAGE_SIZE);
+	}
+	if (b->kva) {
+		kmem_free(kernel_map, b->kva, (vm_size_t)b->size);
+	}
+	memset(b, 0, sizeof(*b));
+}
+
+uint64_t
+sweet_a6xx_native_open(void)
+{
+	uint64_t owner;
+	lck_mtx_lock(&sweet_a6xx_lock);
+	do {
+		owner = ++native_next_owner;
+	} while (owner == 0);
+	lck_mtx_unlock(&sweet_a6xx_lock);
+	return owner;
+}
+
+void
+sweet_a6xx_native_close(uint64_t owner)
+{
+	if (owner == 0) {
+		return;
+	}
+	lck_mtx_lock(&sweet_a6xx_lock);
+	for (int i = 0; i < NATIVE_MAX_BO; i++) {
+		if (native_bos[i].used && native_bos[i].owner == owner) {
+			native_bo_destroy(&native_bos[i]);
+		}
+	}
+	lck_mtx_unlock(&sweet_a6xx_lock);
+}
+
+int
+sweet_a6xx_native_bo_alloc(uint64_t owner, uint64_t size, uint32_t align_log2,
+    uint32_t contiguous, uint64_t *out_handle)
+{
+	if (!gpu_ready || owner == 0 || out_handle == NULL ||
+	    size == 0 || (size & PAGE_MASK) || size > NATIVE_MAX_BO_BYTES ||
+	    align_log2 < PAGE_SHIFT || align_log2 > 24 || contiguous > 1) {
+		return -1;
+	}
+
+	lck_mtx_lock(&sweet_a6xx_lock);
+	int slot = -1;
+	for (int i = 0; i < NATIVE_MAX_BO; i++) {
+		if (!native_bos[i].used) {
+			slot = i;
+			break;
+		}
+	}
+	if (slot < 0) {
+		lck_mtx_unlock(&sweet_a6xx_lock);
+		return -1;
+	}
+
+	vm_offset_t kva = 0;
+	vm_size_t align = ((vm_size_t)1 << align_log2) - 1;
+	if (kmem_alloc_contig(kernel_map, &kva, (vm_size_t)size, align, 0, 0,
+	    KMA_DATA | KMA_ZERO, VM_KERN_MEMORY_IOKIT) != KERN_SUCCESS) {
+		lck_mtx_unlock(&sweet_a6xx_lock);
+		return -1;
+	}
+	ppnum_t pn = pmap_find_phys(kernel_pmap, (addr64_t)kva);
+	if (pn == 0) {
+		kmem_free(kernel_map, kva, (vm_size_t)size);
+		lck_mtx_unlock(&sweet_a6xx_lock);
+		return -1;
+	}
+
+	struct sweet_native_bo *b = &native_bos[slot];
+	memset(b, 0, sizeof(*b));
+	b->owner = owner;
+	b->size = size;
+	b->kva = kva;
+	b->pa = ptoa_64(pn);
+	b->used = true;
+	*out_handle = (uint64_t)slot + 1;
+	lck_mtx_unlock(&sweet_a6xx_lock);
+	return 0;
+}
+
+int
+sweet_a6xx_native_bo_map(uint64_t owner, uint64_t handle, uint64_t iova,
+    uint32_t permissions, uint32_t writeback, uint32_t shareability)
+{
+	if (!(permissions & 1) || (permissions & ~3u) || writeback > 1 ||
+	    (shareability != 2 && shareability != 3) || (iova & PAGE_MASK)) {
+		return -1;
+	}
+	lck_mtx_lock(&sweet_a6xx_lock);
+	struct sweet_native_bo *b = native_bo(owner, handle);
+	if (b == NULL || b->mapped || iova < NATIVE_VA_BASE ||
+	    iova - NATIVE_VA_BASE >= NATIVE_VA_SIZE ||
+	    b->size > NATIVE_VA_BASE + NATIVE_VA_SIZE - iova ||
+	    a6_map(&gpu, iova, b->pa, b->size)) {
+		lck_mtx_unlock(&sweet_a6xx_lock);
+		return -1;
+	}
+	if (a6_tlb_flush(&gpu)) {
+		(void)a6_unmap_pages(&gpu, iova, (uint32_t)(b->size >> PAGE_SHIFT),
+		    PAGE_SIZE);
+		(void)a6_tlb_flush(&gpu);
+		gpu_ready = false;
+		a6_log("native map: TLB invalidation timed out; GPU disabled\n");
+		lck_mtx_unlock(&sweet_a6xx_lock);
+		return -1;
+	}
+	b->iova = iova;
+	b->mapped = true;
+	lck_mtx_unlock(&sweet_a6xx_lock);
+	return 0;
+}
+
+int
+sweet_a6xx_native_bo_free(uint64_t owner, uint64_t handle)
+{
+	lck_mtx_lock(&sweet_a6xx_lock);
+	struct sweet_native_bo *b = native_bo(owner, handle);
+	if (b == NULL || b->leases != 0) {
+		lck_mtx_unlock(&sweet_a6xx_lock);
+		return -1;
+	}
+	native_bo_destroy(b);
+	lck_mtx_unlock(&sweet_a6xx_lock);
+	return 0;
+}
+
+int
+sweet_a6xx_native_bo_cpu_map(uint64_t owner, uint64_t handle, uint32_t *token,
+    uint64_t *size)
+{
+	lck_mtx_lock(&sweet_a6xx_lock);
+	struct sweet_native_bo *b = native_bo(owner, handle);
+	if (b == NULL || b->leases != 0 || token == NULL || size == NULL) {
+		lck_mtx_unlock(&sweet_a6xx_lock);
+		return -1;
+	}
+	b->leases = 1;
+	*token = (uint32_t)handle;
+	*size = b->size;
+	lck_mtx_unlock(&sweet_a6xx_lock);
+	return 0;
+}
+
+int
+sweet_a6xx_native_bo_cpu_unmap(uint64_t owner, uint64_t handle, uint32_t token)
+{
+	lck_mtx_lock(&sweet_a6xx_lock);
+	struct sweet_native_bo *b = native_bo(owner, handle);
+	if (b == NULL || b->leases == 0 || token != (uint32_t)handle) {
+		lck_mtx_unlock(&sweet_a6xx_lock);
+		return -1;
+	}
+	b->leases = 0;
+	lck_mtx_unlock(&sweet_a6xx_lock);
+	return 0;
+}
+
+int
+sweet_a6xx_native_bo_info(uint64_t owner, uint32_t token, vm_offset_t *kva,
+    uint64_t *size)
+{
+	lck_mtx_lock(&sweet_a6xx_lock);
+	struct sweet_native_bo *b = native_bo(owner, token);
+	if (b == NULL || b->leases == 0 || kva == NULL || size == NULL) {
+		lck_mtx_unlock(&sweet_a6xx_lock);
+		return -1;
+	}
+	*kva = b->kva;
+	*size = b->size;
+	lck_mtx_unlock(&sweet_a6xx_lock);
+	return 0;
+}
+
+static void
+native_bo_flush(struct sweet_native_bo *b)
+{
+	flush_dcache64((addr64_t)b->pa, (unsigned)b->size, TRUE);
+}
+
+int sweet_a6xx_native_wait_fence(uint64_t fence, uint64_t timeout_ns);
+
+int
+sweet_a6xx_native_submit(uint64_t owner, const struct SweetNativeSubmit *request,
+    uint32_t *out_fence)
+{
+	if (!gpu_ready || owner == 0 || request == NULL || out_fence == NULL ||
+	    request->buffer_count == 0 ||
+	    request->buffer_count > SweetNativeAbiMaxBuffers || request->reserved) {
+		return -1;
+	}
+	if (request->wait_fence &&
+	    sweet_a6xx_native_wait_fence(request->wait_fence, request->wait_timeout_ns)) {
+		return -1;
+	}
+	lck_mtx_lock(&sweet_a6xx_lock);
+	for (uint32_t i = 0; i < request->buffer_count; i++) {
+		const struct SweetNativeSubmitBuffer *wire = &request->buffers[i];
+		struct sweet_native_bo *b = native_bo(owner, wire->handle);
+		uint64_t dwords = wire->bytes / 4;
+		if (b == NULL || !b->mapped || wire->bytes == 0 ||
+		    (wire->bytes & 3) || dwords > 0xfffff ||
+		    wire->iova < b->iova ||
+		    wire->iova - b->iova > b->size ||
+		    wire->bytes > b->size - (wire->iova - b->iova)) {
+			lck_mtx_unlock(&sweet_a6xx_lock);
+			return -1;
+		}
+		native_bo_flush(b);
+	}
+	for (uint32_t i = 0; i < request->buffer_count; i++) {
+		const struct SweetNativeSubmitBuffer *wire = &request->buffers[i];
+		if (a6_submit_ib(&gpu, wire->iova, (uint32_t)(wire->bytes / 4), 500)) {
+			uint64_t far = 0;
+			uint32_t syn = 0, fsr = a6_fault_status(&gpu, &far, &syn);
+			a6_log("native submit: timeout (fence %u, buffer %u, smmu fsr %x far %llx)\n",
+			    gpu.fence, i, fsr, far);
+			(void)a6_clear_fault(&gpu);
+			gpu_diag_dma_unsafe = true;
+			gpu_ready = false;
+			lck_mtx_unlock(&sweet_a6xx_lock);
+			return -1;
+		}
+	}
+	*out_fence = gpu.fence;
+	lck_mtx_unlock(&sweet_a6xx_lock);
+	return 0;
+}
+
+int
+sweet_a6xx_native_wait_fence(uint64_t fence, uint64_t timeout_ns)
+{
+	if (fence == 0 || fence > gpu.fence) {
+		return -1;
+	}
+	if (a6_fence_read(&gpu) >= fence) {
+		return 0;
+	}
+	uint64_t ms = timeout_ns / 1000000;
+	if (ms > 60000) {
+		ms = 60000;
+	}
+	return sweet_a6xx_wait_fence((uint32_t)fence, (uint32_t)ms);
+}
+
+uint64_t
+sweet_a6xx_native_timestamp(void)
+{
+	uint64_t lo = a6_rd(A6_GREG(0x980));
+	uint64_t hi = a6_rd(A6_GREG(0x981));
+	return lo | (hi << 32);
+}
+
+int
+sweet_a6xx_native_set_metadata(uint64_t owner, uint64_t handle,
+    const void *bytes, uint32_t size)
+{
+	if (bytes == NULL || size > sizeof(((struct sweet_native_bo *)0)->metadata)) {
+		return -1;
+	}
+	lck_mtx_lock(&sweet_a6xx_lock);
+	struct sweet_native_bo *b = native_bo(owner, handle);
+	if (b == NULL) {
+		lck_mtx_unlock(&sweet_a6xx_lock);
+		return -1;
+	}
+	memcpy(b->metadata, bytes, size);
+	b->metadata_set = true;
+	lck_mtx_unlock(&sweet_a6xx_lock);
+	return 0;
+}
+
+int
+sweet_a6xx_native_get_metadata(uint64_t owner, uint64_t handle,
+    void *bytes, uint32_t capacity, uint32_t *out_size)
+{
+	if (bytes == NULL || out_size == NULL) {
+		return -1;
+	}
+	lck_mtx_lock(&sweet_a6xx_lock);
+	struct sweet_native_bo *b = native_bo(owner, handle);
+	if (b == NULL || !b->metadata_set) {
+		lck_mtx_unlock(&sweet_a6xx_lock);
+		return -1;
+	}
+	uint32_t size = capacity < sizeof(b->metadata) ? capacity : sizeof(b->metadata);
+	memcpy(bytes, b->metadata, size);
+	*out_size = size;
+	lck_mtx_unlock(&sweet_a6xx_lock);
+	return 0;
+}
+
+
 #endif /* ARM64_BOARD_CONFIG_GUACAMOLE */
+
+

diff --git a/bsd/dev/sweet_native_abi.h b/bsd/dev/sweet_native_abi.h
new file mode 100644
index 0000000..2f8aa44
--- /dev/null
+++ b/bsd/dev/sweet_native_abi.h
@@ -0,0 +1,192 @@
+/*
+ * NativeAdreno ABI v2, wire-compatible with UniXNU/NativeAdreno.
+ *
+ * This is a fixed-size IOKit structure-method ABI, not an ioctl ABI.  The
+ * SweetMetal 0..7 scalar contract remains separate and unchanged.  We keep
+ * the public record names and values identical so an unmodified Turnip
+ * Darwin backend can talk to this service.
+ */
+#ifndef SWEET_NATIVE_ABI_H
+#define SWEET_NATIVE_ABI_H
+
+#include <stdint.h>
+
+enum {
+	SweetNativeAbiVersion = 2,
+	SweetNativeAbiMaxBuffers = 128,
+	SweetNativeMethodQuery = 1,
+	SweetNativeMethodBoAlloc = 2,
+	SweetNativeMethodBoMap = 3,
+	SweetNativeMethodBoFree = 4,
+	SweetNativeMethodSubmit = 5,
+	SweetNativeMethodWaitFence = 6,
+	SweetNativeMethodGetTimestamp = 7,
+	SweetNativeMethodGetStatus = 8,
+	SweetNativeMethodSetMetadata = 9,
+	SweetNativeMethodGetMetadata = 10,
+	SweetNativeMethodCreateQueue = 11,
+	SweetNativeMethodCloseQueue = 12,
+	SweetNativeMethodBoCpuMap = 13,
+	SweetNativeMethodBoCpuUnmap = 14,
+	SweetNativeMethodGetDeviceInfo = 15,
+	SweetNativeMethodBoImport = 16,
+	SweetNativeMethodSetPriority = 17,
+	SweetNativeMethodNote = 18,
+	SweetNativeMetadataBytes = 64,
+	SweetNativeNoteWords = 30
+};
+
+struct SweetNativeParams {
+	uint32_t abi_version;
+	uint32_t input_bits;
+	uint32_t output_bits;
+	uint32_t flags;
+	uint64_t max_bo_bytes;
+};
+
+enum {
+	SweetNativeParamsHostImport = 1,
+	SweetNativeParamsOwnedCoherent = 2,
+	SweetNativeParamsMemoryPressure = 4
+};
+
+struct SweetNativeBoAlloc {
+	uint64_t bytes;
+	uint32_t align_log2;
+	uint32_t contiguous;
+};
+
+struct SweetNativeBoAllocReply {
+	uint64_t handle;
+};
+
+struct SweetNativeBoImport {
+	uint64_t address;
+	uint64_t bytes;
+};
+
+struct SweetNativeBoMap {
+	uint64_t handle;
+	uint64_t iova;
+	uint32_t permissions;
+	uint32_t writeback;
+	uint32_t shareability;
+	uint32_t reserved;
+};
+
+struct SweetNativeBoMapReply {
+	uint64_t iova;
+};
+
+struct SweetNativeBoFree {
+	uint64_t handle;
+};
+
+struct SweetNativeSubmitBuffer {
+	uint64_t handle;
+	uint64_t iova;
+	uint64_t bytes;
+};
+
+struct SweetNativeSubmit {
+	uint32_t buffer_count;
+	uint32_t reserved;
+	uint64_t queue;
+	uint64_t wait_fence;
+	uint64_t wait_timeout_ns;
+	struct SweetNativeSubmitBuffer buffers[SweetNativeAbiMaxBuffers];
+};
+
+struct SweetNativeMetadata {
+	uint64_t handle;
+	uint32_t bytes;
+	uint32_t reserved;
+	char text[SweetNativeMetadataBytes];
+};
+
+struct SweetNativeSubmitReply {
+	uint64_t fence;
+};
+
+struct SweetNativeWaitFence {
+	uint64_t fence;
+	uint64_t timeout_ns;
+};
+
+struct SweetNativeTimestamp {
+	uint64_t ticks;
+};
+
+struct SweetNativeBoCpuMap {
+	uint64_t handle;
+};
+
+struct SweetNativeBoCpuMapReply {
+	uint32_t token;
+	uint32_t reserved;
+	uint64_t bytes;
+};
+
+struct SweetNativeBoCpuUnmap {
+	uint64_t handle;
+	uint32_t token;
+	uint32_t reserved;
+};
+
+struct SweetNativePriority {
+	uint32_t foreground;
+	uint32_t background;
+};
+
+struct SweetNativeNote {
+	uint32_t kind;
+	uint32_t count;
+	uint32_t words[SweetNativeNoteWords];
+};
+
+struct SweetNativeQueue {
+	uint64_t queue;
+};
+
+struct SweetNativeQueueReply {
+	uint64_t queue;
+};
+
+struct SweetNativeStatus {
+	uint64_t faults;
+	uint64_t suspends;
+};
+
+enum {
+	SweetNativeDeviceClientIova = 1,
+	SweetNativeDeviceCachedCoherent = 2
+};
+
+struct SweetNativeDeviceInfo {
+	uint32_t chip_id;
+	uint32_t gmem_bytes;
+	uint64_t gmem_base;
+	uint64_t uche_trap_base;
+	uint64_t va_start;
+	uint64_t va_size;
+	uint32_t highest_bank_bit;
+	uint32_t ubwc_swizzle;
+	uint32_t macrotile_mode;
+	uint32_t ubwc_version;
+	uint32_t flags;
+	uint32_t reserved;
+};
+
+#ifdef __cplusplus
+static_assert(sizeof(struct SweetNativeParams) == 24, "NativeAdreno params ABI");
+static_assert(sizeof(struct SweetNativeBoAlloc) == 16, "NativeAdreno alloc ABI");
+static_assert(sizeof(struct SweetNativeBoMap) == 32, "NativeAdreno map ABI");
+static_assert(sizeof(struct SweetNativeSubmit) == 32 + 24 * SweetNativeAbiMaxBuffers,
+    "NativeAdreno submit ABI");
+static_assert(sizeof(struct SweetNativeMetadata) == 80, "NativeAdreno metadata ABI");
+static_assert(sizeof(struct SweetNativeBoCpuMapReply) == 16, "NativeAdreno cpu-map ABI");
+static_assert(sizeof(struct SweetNativeBoCpuUnmap) == 16, "NativeAdreno cpu-unmap ABI");
+static_assert(sizeof(struct SweetNativeDeviceInfo) == 64, "NativeAdreno device-info ABI");
+#endif
+
+#endif /* SWEET_NATIVE_ABI_H */

