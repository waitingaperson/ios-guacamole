+static bool
+nativeSizes(uint32_t selector, size_t *input, size_t *output)
+{
+	switch (selector) {
+	case SweetNativeMethodQuery:
+	case SweetNativeMethodGetTimestamp:
+	case SweetNativeMethodGetStatus:
+	case SweetNativeMethodGetDeviceInfo:
+		*input = 0;
+		break;
+	case SweetNativeMethodBoAlloc:
+		*input = sizeof(struct SweetNativeBoAlloc);
+		break;
+	case SweetNativeMethodBoMap:
+		*input = sizeof(struct SweetNativeBoMap);
+		break;
+	case SweetNativeMethodBoImport:
+		*input = sizeof(struct SweetNativeBoImport);
+		break;
+	case SweetNativeMethodBoFree:
+		*input = sizeof(struct SweetNativeBoFree);
+		break;
+	case SweetNativeMethodSubmit:
+		*input = sizeof(struct SweetNativeSubmit);
+		break;
+	case SweetNativeMethodSetMetadata:
+	case SweetNativeMethodGetMetadata:
+		*input = sizeof(struct SweetNativeMetadata);
+		break;
+	case SweetNativeMethodCreateQueue:
+	case SweetNativeMethodCloseQueue:
+		*input = sizeof(struct SweetNativeQueue);
+		break;
+	case SweetNativeMethodBoCpuMap:
+		*input = sizeof(struct SweetNativeBoCpuMap);
+		break;
+	case SweetNativeMethodBoCpuUnmap:
+		*input = sizeof(struct SweetNativeBoCpuUnmap);
+		break;
+	case SweetNativeMethodWaitFence:
+		*input = sizeof(struct SweetNativeWaitFence);
+		break;
+	case SweetNativeMethodSetPriority:
+		*input = sizeof(struct SweetNativePriority);
+		break;
+	case SweetNativeMethodNote:
+		*input = sizeof(struct SweetNativeNote);
+		break;
+	default:
+		return false;
+	}
+
+	switch (selector) {
+	case SweetNativeMethodQuery:
+		*output = sizeof(struct SweetNativeParams);
+		break;
+	case SweetNativeMethodBoAlloc:
+	case SweetNativeMethodBoImport:
+		*output = sizeof(struct SweetNativeBoAllocReply);
+		break;
+	case SweetNativeMethodBoMap:
+		*output = sizeof(struct SweetNativeBoMapReply);
+		break;
+	case SweetNativeMethodSubmit:
+		*output = sizeof(struct SweetNativeSubmitReply);
+		break;
+	case SweetNativeMethodGetTimestamp:
+		*output = sizeof(struct SweetNativeTimestamp);
+		break;
+	case SweetNativeMethodGetStatus:
+		*output = sizeof(struct SweetNativeStatus);
+		break;
+	case SweetNativeMethodGetDeviceInfo:
+		*output = sizeof(struct SweetNativeDeviceInfo);
+		break;
+	case SweetNativeMethodGetMetadata:
+		*output = sizeof(struct SweetNativeMetadata);
+		break;
+	case SweetNativeMethodCreateQueue:
+		*output = sizeof(struct SweetNativeQueueReply);
+		break;
+	case SweetNativeMethodBoCpuMap:
+		*output = sizeof(struct SweetNativeBoCpuMapReply);
+		break;
+	case SweetNativeMethodBoFree:
+	case SweetNativeMethodWaitFence:
+	case SweetNativeMethodSetMetadata:
+	case SweetNativeMethodCloseQueue:
+	case SweetNativeMethodBoCpuUnmap:
+	case SweetNativeMethodSetPriority:
+	case SweetNativeMethodNote:
+		*output = 0;
+		break;
+	default:
+		return false;
+	}
+	return true;
+}
+
+IOReturn
+SweetAcceleratorClient::nativeExternalMethod(uint32_t selector, IOExternalMethodArguments *args)
+{
+	size_t input_size = 0, output_size = 0;
+	if (!nativeSizes(selector, &input_size, &output_size) ||
+	    args->structureInputSize != input_size ||
+	    args->structureOutputSize != output_size ||
+	    (input_size && args->structureInput == NULL) ||
+	    (output_size && args->structureOutput == NULL)) {
+		return kIOReturnBadArgument;
+	}
+	const void *input = args->structureInput;
+	void *output = args->structureOutput;
+	if (selector != SweetNativeMethodQuery && !sweet_gpu_ready()) {
+		return kIOReturnNotReady;
+	}
+
+	switch (selector) {
+	case SweetNativeMethodQuery: {
+		struct SweetNativeParams reply = {};
+		reply.abi_version = SweetNativeAbiVersion;
+		reply.input_bits = 39;
+		reply.output_bits = 40;
+		reply.flags = 0;
+		reply.max_bo_bytes = 0x20000000ULL;
+		memcpy(output, &reply, sizeof(reply));
+		return kIOReturnSuccess;
+	}
+	case SweetNativeMethodGetDeviceInfo: {
+		struct SweetNativeDeviceInfo reply = {};
+		reply.chip_id = 0x06040001;
+		reply.gmem_bytes = 512 * 1024;
+		reply.gmem_base = 0;
+		reply.uche_trap_base = 0x1fffffffff000ULL;
+		reply.va_start = 0x2000000000ULL;
+		reply.va_size = 0x1000000000ULL;
+		reply.highest_bank_bit = 14;
+		reply.ubwc_swizzle = 6;
+		reply.macrotile_mode = 1;
+		reply.ubwc_version = 3;
+		reply.flags = SweetNativeDeviceClientIova;
+		memcpy(output, &reply, sizeof(reply));
+		return kIOReturnSuccess;
+	}
+	case SweetNativeMethodBoAlloc: {
+		const struct SweetNativeBoAlloc *request =
+		    (const struct SweetNativeBoAlloc *)input;
+		struct SweetNativeBoAllocReply reply = {};
+		if (sweet_a6xx_native_bo_alloc(fAbiOwner, request->bytes,
+		    request->align_log2, request->contiguous, &reply.handle)) {
+			return kIOReturnNoMemory;
+		}
+		memcpy(output, &reply, sizeof(reply));
+		return kIOReturnSuccess;
+	}
+	case SweetNativeMethodBoMap: {
+		const struct SweetNativeBoMap *request =
+		    (const struct SweetNativeBoMap *)input;
+		struct SweetNativeBoMapReply reply = {};
+		if (request->reserved ||
+		    sweet_a6xx_native_bo_map(fAbiOwner, request->handle, request->iova,
+		    request->permissions, request->writeback, request->shareability)) {
+			return kIOReturnBadArgument;
+		}
+		reply.iova = request->iova;
+		memcpy(output, &reply, sizeof(reply));
+		return kIOReturnSuccess;
+	}
+	case SweetNativeMethodBoFree: {
+		const struct SweetNativeBoFree *request =
+		    (const struct SweetNativeBoFree *)input;
+		return sweet_a6xx_native_bo_free(fAbiOwner, request->handle) ?
+		    kIOReturnBadArgument : kIOReturnSuccess;
+	}
+	case SweetNativeMethodBoCpuMap: {
+		const struct SweetNativeBoCpuMap *request =
+		    (const struct SweetNativeBoCpuMap *)input;
+		struct SweetNativeBoCpuMapReply reply = {};
+		if (sweet_a6xx_native_bo_cpu_map(fAbiOwner, request->handle,
+		    &reply.token, &reply.bytes)) {
+			return kIOReturnBadArgument;
+		}
+		memcpy(output, &reply, sizeof(reply));
+		return kIOReturnSuccess;
+	}
+	case SweetNativeMethodBoCpuUnmap: {
+		const struct SweetNativeBoCpuUnmap *request =
+		    (const struct SweetNativeBoCpuUnmap *)input;
+		if (request->reserved ||
+		    sweet_a6xx_native_bo_cpu_unmap(fAbiOwner, request->handle,
+		    request->token)) {
+			return kIOReturnBadArgument;
+		}
+		return kIOReturnSuccess;
+	}
+	case SweetNativeMethodSubmit: {
+		const struct SweetNativeSubmit *request =
+		    (const struct SweetNativeSubmit *)input;
+		struct SweetNativeSubmitReply reply = {};
+		if (request->queue >= 64 ||
+		    (request->queue != 0 && !(fQueueMask & (1ULL << request->queue)))) {
+			return kIOReturnBadArgument;
+		}
+		if (sweet_a6xx_native_submit(fAbiOwner, request, (uint32_t *)&reply.fence)) {
+			return kIOReturnError;
+		}
+		memcpy(output, &reply, sizeof(reply));
+		return kIOReturnSuccess;
+	}
+	case SweetNativeMethodWaitFence: {
+		const struct SweetNativeWaitFence *request =
+		    (const struct SweetNativeWaitFence *)input;
+		return sweet_a6xx_native_wait_fence(request->fence, request->timeout_ns) ?
+		    kIOReturnTimeout : kIOReturnSuccess;
+	}
+	case SweetNativeMethodGetTimestamp: {
+		struct SweetNativeTimestamp reply = {};
+		reply.ticks = sweet_a6xx_native_timestamp();
+		memcpy(output, &reply, sizeof(reply));
+		return kIOReturnSuccess;
+	}
+	case SweetNativeMethodGetStatus: {
+		struct SweetNativeStatus reply = {};
+		memcpy(output, &reply, sizeof(reply));
+		return kIOReturnSuccess;
+	}
+	case SweetNativeMethodSetMetadata: {
+		const struct SweetNativeMetadata *request =
+		    (const struct SweetNativeMetadata *)input;
+		if (request->reserved || request->bytes > SweetNativeMetadataBytes ||
+		    sweet_a6xx_native_set_metadata(fAbiOwner, request->handle,
+		    request->text, request->bytes)) {
+			return kIOReturnBadArgument;
+		}
+		return kIOReturnSuccess;
+	}
+	case SweetNativeMethodGetMetadata: {
+		const struct SweetNativeMetadata *request =
+		    (const struct SweetNativeMetadata *)input;
+		struct SweetNativeMetadata reply = {};
+		uint32_t got = 0;
+		if (request->reserved ||
+		    sweet_a6xx_native_get_metadata(fAbiOwner, request->handle,
+		    reply.text, request->bytes, &got)) {
+			return kIOReturnBadArgument;
+		}
+		reply.handle = request->handle;
+		reply.bytes = got;
+		memcpy(output, &reply, sizeof(reply));
+		return kIOReturnSuccess;
+	}
+	case SweetNativeMethodCreateQueue: {
+		struct SweetNativeQueueReply reply = {};
+		for (uint32_t q = 1; q < 64; q++) {
+			if (!(fQueueMask & (1ULL << q))) {
+				fQueueMask |= 1ULL << q;
+				reply.queue = q;
+				break;
+			}
+		}
+		if (reply.queue == 0) {
+			return kIOReturnNoResources;
+		}
+		memcpy(output, &reply, sizeof(reply));
+		return kIOReturnSuccess;
+	}
+	case SweetNativeMethodCloseQueue: {
+		const struct SweetNativeQueue *request =
+		    (const struct SweetNativeQueue *)input;
+		if (request->queue == 0 || request->queue >= 64 ||
+		    !(fQueueMask & (1ULL << request->queue))) {
+			return kIOReturnBadArgument;
+		}
+		fQueueMask &= ~(1ULL << request->queue);
+		return kIOReturnSuccess;
+	}
+	case SweetNativeMethodSetPriority: {
+		const struct SweetNativePriority *request =
+		    (const struct SweetNativePriority *)input;
+		if (request->foreground > 5 || request->background > 5) {
+			return kIOReturnBadArgument;
+		}
+		return kIOReturnSuccess;
+	}
+	case SweetNativeMethodNote: {
+		const struct SweetNativeNote *request =
+		    (const struct SweetNativeNote *)input;
+		if (request->count > SweetNativeNoteWords) {
+			return kIOReturnBadArgument;
+		}
+		return kIOReturnSuccess;
+	}
+	case SweetNativeMethodBoImport:
+		return kIOReturnUnsupported;
+	default:
+		return kIOReturnUnsupported;
+	}
+}
