+	/* The old order probed a path under /private/var before it tried the
+	 * existing /System/Library directories. When that probe's parent could
+	 * not be created, a payload that could write its real destination waited
+	 * two minutes and never ran. Try both destinations first; wait and retry
+	 * only when a destination reported an error. */
+	if (syse != 0 || vare != 0) {
+		(void)ov_wait_writable();
+		ov_variant = 0;
+		ov_walk(bytes, size);
+		sysf = ov_nfiles;
+		sysd = ov_ndirs;
+		syse = ov_nerrs;
+		ov_log("System retry: %u files, %u dirs, %u errors\n",
+		    sysf, sysd, syse);
+
+		ov_variant = 1;
+		ov_walk(bytes, size);
+		varf = ov_nfiles;
+		vard = ov_ndirs;
+		vare = ov_nerrs;
+		ov_log("/private/var/local retry: %u files, %u dirs, %u errors\n",
+		    varf, vard, vare);
+	}
+
 	/* Only the fallback copy is complete, so point Metal at it. */
