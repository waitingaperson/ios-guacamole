From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Codex <codex@openai.com>
Date: Sun, 1 Nov 2026 20:20:00 +0800
Subject: [PATCH] sweet-a6xx: fence submissions with a cache flush

Match the A6xx submission boundary used by the reference drivers:
invalidate the colour/depth CCUs and UCHE before an IB, then retire the
submission with CACHE_FLUSH_TS and CP_WAIT_MEM_GTE. The previous
CP_MEM_WRITE fence proved command consumption but did not require dirty
render cachelines to reach memory first.

Keep CP_EVENT_WRITE's TIMESTAMP bit clear. On the A640 it replaces the
fence value with the GPU clock, so waiters never observe the expected
sequence number.
---
 bsd/dev/sweet_a6xx.c | 10 +++++++++-
 bsd/dev/sweet_a6xx.h |  1 +
 2 files changed, 11 insertions(+), 1 deletion(-)

diff --git a/bsd/dev/sweet_a6xx.h b/bsd/dev/sweet_a6xx.h
--- a/bsd/dev/sweet_a6xx.h
+++ b/bsd/dev/sweet_a6xx.h
@@ -142,7 +142,8 @@
 #define A6_BLIT_MAX_DW	256
 uint32_t a6_blit_ib(const struct a6_gpu *g, const struct a6_blit *b, uint32_t *dw);
 
 #define A6_CP_NOP		0x10
+#define A6_CP_WAIT_MEM_GTE 0x14
 #define A6_CP_WAIT_FOR_IDLE	0x26
 #define A6_CP_BLIT		0x2c
 #define A6_CP_MEM_WRITE		0x3d
diff --git a/bsd/dev/sweet_a6xx.c b/bsd/dev/sweet_a6xx.c
--- a/bsd/dev/sweet_a6xx.c
+++ b/bsd/dev/sweet_a6xx.c
@@ -817,12 +817,21 @@ a6_submit_ib(struct a6_gpu *g, uint64_t iova, uint32_t dwords, unsigned timeout_m
 int a6_submit_ib(struct a6_gpu *g, uint64_t iova, uint32_t dwords, unsigned timeout_ms)
 {
 	uint64_t fva = a6_pool_va(A6_OFF_SCRATCH);
 	uint32_t fence = ++g->fence;
 	uint32_t dw[] = {
+		a6_pkt7(A6_CP_EVENT_WRITE, 1), 0x19,	/* PC_CCU_INVALIDATE_COLOR */
+		a6_pkt7(A6_CP_EVENT_WRITE, 1), 0x1a,	/* PC_CCU_INVALIDATE_DEPTH */
+		a6_pkt7(A6_CP_EVENT_WRITE, 1), 0x31,	/* CACHE_INVALIDATE */
+		a6_pkt7(A6_CP_WAIT_FOR_IDLE, 0),
 		a6_pkt7(A6_CP_INDIRECT_BUFFER, 3), (uint32_t)iova, (uint32_t)(iova >> 32), dwords,
 		a6_pkt7(A6_CP_WAIT_FOR_IDLE, 0),
-		a6_pkt7(A6_CP_MEM_WRITE, 3), (uint32_t)fva, (uint32_t)(fva >> 32), fence,
+		/* The fence write is also the UCHE clean. Do not set TIMESTAMP:
+		 * the A640 then writes its clock instead of the requested value. */
+		a6_pkt7(A6_CP_EVENT_WRITE, 4), 0x04,	/* CACHE_FLUSH_TS */
+		    (uint32_t)fva, (uint32_t)(fva >> 32), fence,
+		a6_pkt7(A6_CP_WAIT_MEM_GTE, 4), 0,
+		    (uint32_t)fva, (uint32_t)(fva >> 32), fence,
 	};
 	int rc = a6_ring(g, dw, sizeof(dw) / 4, NULL, timeout_ms);
 	return rc || a6_fence_read(g) != fence ? -1 : 0;
 }
